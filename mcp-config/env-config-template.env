# MCP服务环境变量配置
# 将以下内容保存为 .env 或在系统环境变量中配置

# ===========================================
# MCP Tool Service 环境变量配置
# ===========================================

# 是否启用外部数据库配置
DM_DB_ENABLED=true

# 数据库连接信息
DM_DB_HOST=127.0.0.1
DM_DB_PORT=5236
DM_DB_NAME=SOIL_SURVEY_DATA_APPLY
DM_DB_USERNAME=SYSDBA
DM_DB_PASSWORD=mll123!@#

# ===========================================
# 配置说明
# ===========================================
# DM_DB_ENABLED: 是否启用外部配置，true启用，false使用application-datasource.yml中的配置
# DM_DB_HOST: 数据库主机IP地址
# DM_DB_PORT: 数据库端口，达梦默认5236
# DM_DB_NAME: 数据库名称
# DM_DB_USERNAME: 数据库用户名
# DM_DB_PASSWORD: 数据库密码

# ===========================================
# 使用示例
# ===========================================
# Windows PowerShell:
#   $env:DM_DB_ENABLED="true"
#   $env:DM_DB_HOST="127.0.0.1"
#   $env:DM_DB_PORT="5236"
#   java -jar tool-service-1.0.0.jar

# Windows CMD:
#   set DM_DB_ENABLED=true
#   set DM_DB_HOST=127.0.0.1
#   java -jar tool-service-1.0.0.jar

# Linux/Mac:
#   export DM_DB_ENABLED=true
#   export DM_DB_HOST=127.0.0.1
#   ./start.sh
