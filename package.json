{
  "name": "md-preview-tool",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "现代化纯前端与内网协同 Markdown 实时预览及 API 调试桌面工具",
  "author": "JHJ1848 <JHJ1848@users.noreply.github.com>",
  "homepage": "https://github.com/JHJ1848/my-tools-api-tool-service",
  "repository": {
    "type": "git",
    "url": "https://github.com/JHJ1848/my-tools-api-tool-service.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "tsc && vite build",
    "dist:app": "vite build && powershell -ExecutionPolicy Bypass -Command \"$root = (Get-Item .).FullName; $targetDir = Join-Path $root 'dist-app'; $appDir = Join-Path $targetDir 'resources\\app'; if (Test-Path (Join-Path $appDir 'dist')) { Remove-Item -Recurse -Force (Join-Path $appDir 'dist') }; if (Test-Path (Join-Path $appDir 'dist-electron')) { Remove-Item -Recurse -Force (Join-Path $appDir 'dist-electron') }; if (Test-Path (Join-Path $appDir 'resources')) { Remove-Item -Recurse -Force (Join-Path $appDir 'resources') }; Copy-Item -Recurse -Force (Join-Path $root 'dist') (Join-Path $appDir 'dist'); Copy-Item -Recurse -Force (Join-Path $root 'dist-electron') (Join-Path $appDir 'dist-electron'); Copy-Item -Recurse -Force (Join-Path $root 'resources') (Join-Path $appDir 'resources'); $pkgJson = '{\\\"name\\\":\\\"md-preview-tool\\\",\\\"version\\\":\\\"1.0.0\\\",\\\"type\\\":\\\"module\\\",\\\"main\\\":\\\"dist-electron/main.js\\\"}'; [System.IO.File]::WriteAllText((Join-Path $appDir 'package.json'), $pkgJson, [System.Text.Encoding]::UTF8);\" && node scripts/patch-exe-icon.js",
    "dist:msi": "node scripts/build-dist.js --target=msi",
    "dist:nsis": "node scripts/build-dist.js --target=nsis",
    "dist:portable": "node scripts/build-dist.js --target=portable",
    "dist:zip": "node scripts/build-dist.js --target=zip",
    "dist:dir": "node scripts/build-dist.js --target=dir",
    "dist:all": "node scripts/build-dist.js --target=all",
    "dist": "npm run dist:all",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run"
  },
  "build": {
    "appId": "com.toolservice.mdpreview",
    "productName": "MD Preview Tool",
    "copyright": "Copyright © 2026 MD Preview Tool. All rights reserved.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "resources/templates"
      },
      {
        "from": "resources/static",
        "to": "resources/static"
      },
      {
        "from": "resources/icon.ico",
        "to": "resources/icon.ico"
      },
      {
        "from": "resources/icon.png",
        "to": "resources/icon.png"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "legalTrademarks": "MD Preview Tool",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MD Preview Tool",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeaderIcon": "resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.exe"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "shortcutName": "MD Preview Tool",
      "artifactName": "${productName}-${version}-${arch}.msi"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.exe"
    }
  },
  "dependencies": {
    "@radix-ui/react-collapsible": "^1.0.3",
    "@radix-ui/react-context-menu": "^2.1.5",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.0.7",
    "chokidar": "^3.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.9",
    "lucide-react": "^0.312.0",
    "marked": "^12.0.0",
    "mermaid": "^10.8.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.3",
    "tailwind-merge": "^2.2.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "electron": "^28.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.33",
    "resedit": "^1.7.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
